# Copy to .env for local development and replace placeholders with local values.
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Use DATABASE_URL or all of DB_HOST, DB_NAME, DB_USER (DB_PASSWORD may be empty).
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mediflow_dev
DB_USER=postgres
DB_PASSWORD=change-me-locally
DB_LOGGING=false

# Comma-separated browser origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

LOG_LEVEL=info
JSON_BODY_LIMIT=1mb
